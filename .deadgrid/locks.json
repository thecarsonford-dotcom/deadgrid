      "allowedModes": ["VIEWMODEL", "GAMEPLAY", "BUGFIX", "RELEASE_QA"]
    },
    {
      "path": "src/assets/components.ts",
      "allowedModes": ["ASSETS", "VIEWMODEL", "BUGFIX", "RELEASE_QA"]
    }
  ]
