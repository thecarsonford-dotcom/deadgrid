{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp-local/qwen3.8-27b-256k",
  "provider": {
    "llamacpp-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:11435/v1"
      },
      "models": {
        "qwen3.8-27b-256k": {
          "name": "Qwen3.8 27B Q4_K_M (local)",
          "limit": {
            "context": 256000,
            "output": 32768
          }
        }
      }
    }
  },
  "default_agent": "build",
  "subagent_depth": 0,
  "instructions": [".deadgrid/instructions.md"],
  "share": "disabled",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "tmp_*/**",
      "tools/qa/shots/**",
      ".deadgrid/runtime/**",
      ".deadgrid/xdg-config/**",
      ".deadgrid/xdg-data/**",
      ".deadgrid/xdg-cache/**",
      ".deadgrid/xdg-state/**"
    ]
  },
  "permission": {
    "doom_loop": "deny",
    "external_directory": "deny",
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "bash": "allow"
  }
}
